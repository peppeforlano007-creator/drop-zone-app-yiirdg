{
  "expo": {
    "name": "Drop Zone",
    "slug": "drop-zone",
    "version": "2.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/dropmarket-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/dropmarket-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.giuseppeforlano.dropzone",
      "buildNumber": "12",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Questa app accede alla tua libreria foto per caricare immagini dei prodotti.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/dropmarket-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Natively",
      "permissions": [
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/images/final_quest_240x240.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "iosNSEEnabled": false
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser"
    ],
    "scheme": "dropzone",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "587d28f9-01b5-4121-aa8e-4d77ee7b13ae"
      },
      "oneSignalAppId": "94d57673-6ccc-47eb-80d5-d5aa8c2a76a1"
    }
  }
}