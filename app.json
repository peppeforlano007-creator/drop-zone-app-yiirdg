{
  "expo": {
    "name": "RDN STREET STOCK MARKET",
    "slug": "rdn-street-stock-market",
    "version": "2.6.16",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/LOGOapp.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.giuseppeforlano.dropzone",
      "buildNumber": "43",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSPhotoLibraryUsageDescription": "Questa app accede alla tua libreria foto per caricare immagini dei prodotti.",
        "NSUserNotificationUsageDescription": "Ricevi notifiche su nuovi drop, aggiornamenti degli ordini e messaggi importanti.",
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "https"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/927fb1de-2d8e-44cf-a9a0-d63717d35ffc.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.giuseppeforlano.dropzone",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 21
    },
    "web": {
      "favicon": "./assets/images/final_quest_240x240.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/rdnstreetstockmarket-icon.png",
          "color": "#000000",
          "sounds": []
        }
      ]
    ],
    "scheme": "rdnstreetstockmarket",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "587d28f9-01b5-4121-aa8e-4d77ee7b13ae"
      }
    }
  }
}